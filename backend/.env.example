# ============================================================
# OPCIÓN LOCAL (Supabase local, `supabase start`)
# Requiere Docker corriendo. La BD se crea en 127.0.0.1:54322
# con las migraciones de supabase/migrations/ aplicadas.
# ============================================================
DB_USER=postgres
DB_HOST=127.0.0.1
DB_NAME=postgres
DB_PASSWORD=postgres
DB_PORT=54322
DB_SSL=false

# ============================================================
# OPCIÓN REMOTA (Supabase pooler, proyecto fimeoxsgabbttjqtxwek)
# Descomentar para usar la BD remota en vez de la local.
# ============================================================
# DB_USER=postgres
# DB_HOST=aws-0-us-west-1.pooler.supabase.com
# DB_NAME=postgres
# DB_PASSWORD=TU_CONTRASEÑA_DE_BD
# DB_PORT=6543
# DB_SSL=true

# JWT
JWT_SECRET=TU_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=7d

# Servidor
PORT=3000