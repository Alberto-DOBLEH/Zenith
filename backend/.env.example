# ============================================================
# OPCIÓN LOCAL (Supabase local, `supabase start`)
# Requiere Docker corriendo. La BD se crea en 127.0.0.1:54322
# con las migraciones de supabase/migrations/ aplicadas.
# ============================================================
DB_USER=postgres
DB_HOST=127.0.0.1
DB_NAME=postgres
DB_PASSWORD=postgres
DB_PORT=54322
DB_SSL=false

# ============================================================
# OPCIÓN REMOTA (Supabase pooler, proyecto fimeoxsgabbttjqtxwek)
# Descomentar para usar la BD remota en vez de la local.
# ============================================================
# DB_USER=postgres.fimeoxsgabbttjqtxwek
# DB_HOST=aws-0-us-west-1.pooler.supabase.com
# DB_NAME=postgres
# DB_PASSWORD=TU_CONTRASEÑA_DE_BD
# DB_PORT=6543
# DB_SSL=true

# JWT
# Generar con: openssl rand -hex 32
JWT_SECRET=TU_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=7d

# CORS: orígenes permitidos separados por comas (ej. https://zenith-frontend.vercel.app)
# Si se omite, se permiten todos los orígenes (modo desarrollo).
# CORS_ORIGIN=https://tu-proyecto.vercel.app

# Rate limit (opcional, con valores por defecto)
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_REGISTRO=50

# Servidor
# PORT=3000  # Render asigna PORT automáticamente; no configurarlo

# Producción (Render): descomentar para ocultar detalles de errores
# NODE_ENV=production

# Brevo API (verificación de correo y avisos)
BREVO_API_KEY=tu_api_key_de_brevo
BREVO_FROM_EMAIL=tu-correo@gmail.com

# Frontend URL para links de verificación
# En desarrollo: http://localhost:4200
# En producción: https://tu-proyecto.vercel.app
FRONTEND_URL=http://localhost:4200